# Leave DATABASE_URL unset to use local SQLite (fine for local dev/demo).
# For Supabase, use the connection string from Project Settings -> Database
# (use the "Session pooler" URI, and make sure sslmode=require is included).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Optional — omit both to run the agent with the deterministic rule-based
# explainer (no external calls, works out of the box).
GROQ_API_KEY=
OPENAI_API_KEY=

AUTO_CLEAR_CONFIDENCE=0.9
SETTLEMENT_LAG_MIN_DAYS=1
SETTLEMENT_LAG_MAX_DAYS=4
AMOUNT_TOLERANCE=0.01

# Optional shared secret. If set, mutating endpoints (/reconcile/run,
# /seed, /import, exception resolution, /settings updates) require an
# X-Api-Key header matching this value. Leave unset for open local dev.
RECONCILE_API_KEY=

# Optional Slack incoming webhook — sends a message after any run that
# leaves exceptions needing review. Leave unset to skip notifications.
SLACK_WEBHOOK_URL=

# Best-effort in-process scheduler (local/dev only — see README for why
# production should use a real cron job instead).
ENABLE_SCHEDULER=false
RECONCILE_INTERVAL_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
